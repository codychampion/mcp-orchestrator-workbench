# Local development defaults
# Use mock mode for public demos and local smoke tests without credentials.
LLM_PROVIDER=mock
MAX_CONCURRENT_CALLS=4
MCP_SERVER_URL=http://mcp-server:8000/sse
LOGGING_SERVICE_URL=http://logging-service:8200

# Optional GitHub Models provider. Never commit real token values.
GITHUB_TOKEN=

# Optional Azure AI provider. Never commit real key values.
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_KEY=
AZURE_AI_FOUNDRY_MODEL=gpt-4o-mini

# Optional local LLM provider.
LOCAL_LLM_URL=http://ollama:11434/v1/chat/completions
LOCAL_LLM_MODEL=tinyllama
